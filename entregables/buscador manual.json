    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const datosOriginales = $('extrae contenido1').all()[index]?.json || {};\n  \n  let raw = item.json?.text || '{}';\n  raw = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  \n  let analisis = {};\n  try {\n    analisis = JSON.parse(raw);\n  } catch(e) {\n    analisis = {\n      tiene_problematica: false,\n      problematica: 'Error al parsear',\n      area_social: 'N/A',\n      area_tecnologica: 'N/A',\n      solucion_sugerida: 'N/A',\n      _error: e.message\n    };\n  }\n\n  return {\n    json: {\n      id: datosOriginales.id,\n      titulo: datosOriginales.titulo,\n      url: datosOriginales.url,\n      fecha: datosOriginales.fecha,\n      analisis: analisis,\n      validacion: {\n        ok: analisis.tiene_problematica !== undefined,\n        tiene_problematica: analisis.tiene_problematica\n      }\n    }\n  };\n});"
      },
