      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const raw = item.json;\n  const firstPost = raw?.post_stream?.posts?.[0];\n  \n  const content = firstPost?.cooked\n    ? firstPost.cooked\n        .replace(/<[^>]*>/g, ' ')\n        .replace(/&amp;/g, '&')\n        .replace(/\\s+/g, ' ')\n        .trim()\n        .slice(0, 2000)\n    : 'Sin contenido';\n\n  return {\n    json: {\n      id: raw.id,\n      titulo: raw.title,\n      url: `https://replit.discourse.group/t/${raw.slug}/${raw.id}`,\n      contenido: content,\n      autor: firstPost?.username || 'desconocido',\n      fecha: raw.created_at,\n      tags: raw.tags || []\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1376,
        688
      ],
      "id": "c4d84180-e69d-42a0-9cca-03b818f949cc",
      "name": "extrae contenido1"
    },
    {
