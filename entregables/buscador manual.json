      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst topics = response.topic_list.topics;\n\nconst cantidadPosts = $('Webhook1').first().json.body.cantidad_posts;\nconst limite = cantidadPosts ? parseInt(cantidadPosts) : topics.length;\n\nreturn topics.slice(0, limite).map(topic => ({\n  json: {\n    id: topic.id,\n    titulo: topic.title,\n    url: `https://replit.discourse.group/t/${topic.slug}/${topic.id}`,\n    fecha: topic.created_at,\n    vistas: topic.views,\n    respuestas: topic.reply_count\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
